[{"title":"Excuse me!","titleCn":"对不起！","lines":[{"en":"Excuse me!","cn":"对不起"},{"en":"Yes?","cn":"什么事？"},{"en":"Is this your handbag?","cn":"这是您的手提包吗？"},{"en":"Pardon?","cn":"对不起，请再说一遍。"},{"en":"Is this your handbag?","cn":"这是您的手提包吗？"},{"en":"Yes, it is.","cn":"是的，是我的。"},{"en":"Thank you very much.","cn":"非常感谢！"}]},{"title":"Sorry, sir.","titleCn":"对不起，先生","lines":[{"en":"My coat and my umbrella please.","cn":"请把我的大衣和伞拿给我。"},{"en":"Here is my ticket.","cn":"这是我（寄存东西）的牌子。"},{"en":"Thank you, sir.","cn":"谢谢，先生。"},{"en":"Number five.","cn":"是5号。"},{"en":"Here's your umbrella and your coat.","cn":"这是您的伞和大衣"},{"en":"This is not my umbrella.","cn":"这不是我的伞。"},{"en":"Sorry sir.","cn":"对不起，先生。"},{"en":"Is this your umbrella?","cn":"这把伞是您的吗？"},{"en":"No, it isn't","cn":"不，不是！"},{"en":"Is this it?","cn":"这把是吗？"},{"en":"Yes, it is.","cn":"是，是这把"},{"en":"Thank you very much.","cn":"非常感谢"}]},{"title":"Nice to meet you","titleCn":"很高兴见到你。","lines":[{"en":"MR. BLAKE:Good morning.","cn":"布莱克先生：早上好。"},{"en":"STUDENTS:Good morning, Mr. Blake.","cn":"学 生：早上好，布莱克先生。"},{"en":"MR. BLAKE:This is Miss Sophie Dupont.","cn":"布莱克先生：这位是索菲娅.杜邦小姐。"},{"en":"Sophie is a new student.","cn":"索菲娅是个新学生。"},{"en":"She is French.","cn":"她是法国人。"},{"en":"MR. BLAKE:Sophie, this is Hans.","cn":"布莱克先生：索菲娅，这位是汉斯。"},{"en":"He is German.","cn":"他是德国人。"},{"en":"HANS:Nice to meet you.","cn":"汉 斯：很高兴见到你。"},{"en":"MR. BLAKE:And this is Naoko.","cn":"布莱克先生：这位是直子。"},{"en":"She's Japanese.","cn":"她是日本人。"},{"en":"NAOKO:Nice to meet you.","cn":"直 子：很高兴见到你。"},{"en":"MR. BLAKE:And this is Chang-woo.","cn":"布莱克先生：这位是昌宇。"},{"en":"He's Korean.","cn":"他是韩国人。"},{"en":"CHANG-WOO:Nice to meet you.","cn":"昌 宇：很高兴见到你。"},{"en":"MR. BLAKE:And this is Luming.","cn":"布莱克先生：这位是鲁明。"},{"en":"He is Chinese.","cn":"他是中国人。"},{"en":"LUMNG:Nice to meet you.","cn":"鲁 明：很高兴见到你。"},{"en":"MR. BLAKE:And this is Xiaohui.","cn":"布莱克先生：这位是晓惠。"},{"en":"She's Chinese, too.","cn":"她也是中国人。"},{"en":"XIAOHUI:Nice to meet you.","cn":"晓 惠：很高兴见到你。"}]},{"title":"Are you a teacher?","titleCn":"你是教师吗?","lines":[{"en":"ROBERT:I am a new student. My name's Robert.","cn":"罗伯特：我是个新学生，我的名字叫罗伯特。"},{"en":"SOPHIE:Nice to meet you. My name's Sophie.","cn":"索菲娅：很高兴见到你。我的名字叫索菲娅。"},{"en":"ROBERT:Are you French?","cn":"罗伯特：你是法国人吗？"},{"en":"SOPHIE:Yes, I am.","cn":"索菲娅：是的，我是法国人。"},{"en":"SOPHIE:Are you French too?","cn":"索菲娅：你也是法国人吗？"},{"en":"ROBERT:No, I am not.","cn":"罗伯特：不，我不是。"},{"en":"SOPHIE:What nationality are you?","cn":"索菲娅：你是哪国人？"},{"en":"ROBERT:I'm Italian.","cn":"罗伯特：我是意大利人。"},{"en":"ROBERT:Are you a teacher?","cn":"罗伯特：你是教师吗？"},{"en":"SOPHIE:No, I'm not.","cn":"索菲娅：不，我不是。"},{"en":"ROBERT:What's your job?","cn":"罗伯特：你是做什么工作的？"},{"en":"SOPHIE:I'm a keyboard operator.","cn":"索菲娅：我是电脑录入员。"},{"en":"SOPHIE:What's your job?","cn":"索菲娅：你是做什么工作的？"},{"en":"ROBERT:I'm an engineer.","cn":"罗伯特：我是工程师。"}]},{"title":"How are you today?","titleCn":"今天好吗？","lines":[{"en":"STEVEN:Hello, HELEN.","cn":"史蒂文：你好，海伦"},{"en":"HELEN:Hi, Steven.","cn":"海 伦：你好，史蒂文"},{"en":"STEVEN:How are you today?","cn":"史蒂文：你今天好吗？"},{"en":"HELEN:I'm very well, thank you. And you?","cn":"海 伦：很好，谢谢你。你好吗？"},{"en":"STEVEN:I'm fine, thanks.","cn":"史蒂文：很好，谢谢。"},{"en":"STEVEN:How is Tony?","cn":"史蒂文：托尼好吗？"},{"en":"HELEN:He's fine, thanks. How's Emma?","cn":"海 伦：他很好，谢谢。埃玛好吗？"},{"en":"STEVEN:She's very well, too, Helen.","cn":"史蒂文：她也很好，海伦。"},{"en":"STEVEN:Goodbye, Helen.Nice to see you.","cn":"史蒂文：再见，海伦。见到你真高兴。"},{"en":"HELEN:Nice to see you, too, Steven. Goodbye.","cn":"海 伦：我见到你也很高兴，史蒂文。再见。"}]}]